         background reference; the new adaptive icon uses @drawable/ic_launcher_background instead. -->
    <color name="colorPrimary">#5B50E8</color>
    <color name="colorPrimaryDark">#4136C4</color>
    <color name="colorAccent">#7B72EE</color>
</resources>

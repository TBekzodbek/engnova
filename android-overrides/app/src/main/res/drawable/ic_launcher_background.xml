<?xml version="1.0" encoding="utf-8"?>
<!--
    Engnova adaptive icon — background layer.
    Three stacked full-canvas paths, back to front:
      1. Deep near-black linear gradient (top-left → bottom-right)
      2. Bloom — wide indigo radial aura
      3. Halo — tight chromatic radial (white → indigo → cyan → transparent)

    Android AARRGGBB alpha notation:
      0.95 = F2 · 0.85 = D9 · 0.55 = 8C · 0.30 = 4C · 0.15 = 26 · 0.10 = 1A · 0 = 00

    Star centred at (54, 49) — the halo/bloom are centred there too so the
    focal point of the icon is a fraction above canvas centre (the "rising" cue).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Base gradient (near-black) -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108"  android:endY="108">
                <item android:offset="0"   android:color="#FF0B0B18"/>
                <item android:offset="0.6" android:color="#FF08081A"/>
                <item android:offset="1"   android:color="#FF050514"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Bloom — wide indigo aura, centred where the star sits -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="49.7"
                android:gradientRadius="80">
                <item android:offset="0"   android:color="#8C554BE7"/>
                <item android:offset="0.4" android:color="#26554BE7"/>
                <item android:offset="1"   android:color="#00554BE7"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Halo — tight chromatic disc: white core → indigo → cyan edge -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="49.7"
                android:gradientRadius="60">
                <item android:offset="0"    android:color="#F2F5F8FF"/>
                <item android:offset="0.10" android:color="#D9C7C8FF"/>
                <item android:offset="0.28" android:color="#8C7B72EE"/>
                <item android:offset="0.55" android:color="#4C4136C4"/>
                <item android:offset="0.85" android:color="#1A1EA8FF"/>
                <item android:offset="1"    android:color="#001EA8FF"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>

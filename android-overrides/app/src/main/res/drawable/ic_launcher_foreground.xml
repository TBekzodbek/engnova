<?xml version="1.0" encoding="utf-8"?>
<!--
    Engnova adaptive icon — foreground layer.
    Everything inside the 66dp safe zone (radius 33dp from canvas centre 54,54)
    so no launcher mask crops it. Star centred at (54, 49), outer radius 27
    (top point y=22 → 32dp from canvas centre → safe).

    Layers, back to front:
      1. Two diagonal spark rays (thin white lines) — visible only at large sizes
      2. Outer star glow ring (fat stroked path, low alpha) — softens the star edge
      3. Star face (linear gradient, white → cool blue)
      4. Hot spot (radial white) — the "neon electron"
      5. Crisp centre dot — one pixel of pure white
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Spark rays -->
    <path
        android:pathData="M25.3,25.3 L82.7,82.7"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="0.34"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M82.7,25.3 L25.3,82.7"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="0.34"
        android:strokeLineCap="round"/>

    <!-- 2. Outer star glow ring -->
    <path
        android:pathData="M54,22 L61.64,41.36 L81,49 L61.64,56.64 L54,76 L46.36,56.64 L27,49 L46.36,41.36 Z"
        android:strokeColor="#26FFFFFF"
        android:strokeWidth="1.27"
        android:strokeLineJoin="round"/>

    <!-- 3. Star face -->
    <path
        android:pathData="M54,22 L61.64,41.36 L81,49 L61.64,56.64 L54,76 L46.36,56.64 L27,49 L46.36,41.36 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.32"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27" android:startY="22"
                android:endX="76"  android:endY="76">
                <item android:offset="0"   android:color="#FFFFFFFF"/>
                <item android:offset="0.7" android:color="#FFE9ECFF"/>
                <item android:offset="1"   android:color="#FFC7D6FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Hot spot -->
    <path android:pathData="M48.5,49 A5.5,5.5 0 1,0 59.5,49 A5.5,5.5 0 1,0 48.5,49 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="49"
                android:gradientRadius="5.5">
                <item android:offset="0"   android:color="#FFFFFFFF"/>
                <item android:offset="0.5" android:color="#99FFFFFF"/>
                <item android:offset="1"   android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Crisp centre dot -->
    <path
        android:pathData="M53.1,49 A0.9,0.9 0 1,0 54.9,49 A0.9,0.9 0 1,0 53.1,49 Z"
        android:fillColor="#FFFFFFFF"/>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          allowBackup=false  — this is an auth-bearing app. WebView cookie jars
          hold live Supabase session tokens; @capacitor/preferences persists the
          per-track boot hint. Google's Auto Backup would silently upload both
          to Drive and restore onto any device signed into the same Google
          account (including a stolen phone). No app-owned content is worth
          preserving anyway — track choice + language are trivially re-entered.
          data_extraction_rules covers Android 12+ D2D transfer, which allowBackup
          does NOT control. Both must be set to close the leak.
        -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links — one <intent-filter> PER top-level host so
              Play Console's App Links verification report surfaces failures
              per-host (grouping cefracademy.uz + ieltslevel.uz into a single
              filter would hide a broken assetlinks.json on one domain behind
              a green check for the other).

              autoVerify="true" tells the OS to fetch
                https://<host>/.well-known/assetlinks.json
              on install and only route the URL into us if the file lists our
              package + SHA-256. Until the owner publishes both assetlinks
              files (see store-assets/assetlinks-*.json + checklist §9a),
              taps still open the browser — the filter is inert, not broken.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cefracademy.uz" />
                <data android:scheme="https" android:host="www.cefracademy.uz" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ieltslevel.uz" />
                <data android:scheme="https" android:host="www.ieltslevel.uz" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- ── Permissions ────────────────────────────────────────────────────
         Rule for this file: only declare permissions with a live runtime
         consumer in THIS commit. Extra perms inflate Play's Data Safety
         questionnaire, add scary items to the install-time permission list,
         and (for API-33+ dangerous perms like POST_NOTIFICATIONS) silently
         accept a grant for something we never wire up.

         INTERNET     — obviously, both tracks are online-only.
         RECORD_AUDIO — speaking practice on both tracks calls getUserMedia();
                        WebChromeClient.onPermissionRequest wires the OS prompt
                        on first use (EngnovaWebViewPlugin.java:264).

         Add back MODIFY_AUDIO_SETTINGS / ACCESS_NETWORK_STATE /
         POST_NOTIFICATIONS / VIBRATE in the SAME commit that installs the
         plugin (@capacitor/haptics / @capacitor/push-notifications / etc.)
         that actually needs it.

         <uses-feature microphone required=false> — mic is used but the app
         must still install on devices without a mic (Play rejects apps that
         hard-require unusual features).
    ─────────────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>

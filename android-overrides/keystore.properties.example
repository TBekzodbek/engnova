# ─────────────────────────────────────────────────────────────────────────
#  Engnova · Release signing template
# ─────────────────────────────────────────────────────────────────────────
#  1. Generate the keystore first:
#       npm run keystore:generate
#     (interactive — you enter passwords, keytool writes engnova-upload.jks
#      to the android/ folder)
#
#  2. Copy this file to `android/keystore.properties` (drop the `.example`).
#
#  3. Fill in the four values below with the passwords + alias you chose
#     during keystore generation.
#
#  4. NEVER commit the filled file. `android/` is gitignored end-to-end AND
#     `keystore.properties` is explicitly gitignored, so a stray move can't
#     leak it — but treat it like a password anyway.
#
#  Losing the keystore = never being able to update the app on Play again
#  (the upload key IS the app's identity). Back up in 3 places:
#    · Password manager (1Password / Bitwarden vault attachment)
#    · Encrypted external drive
#    · Encrypted cloud backup
# ─────────────────────────────────────────────────────────────────────────

# Path is resolved from android/ (rootProject). Leave as-is if you used
# `npm run keystore:generate` which drops the file exactly here.
storeFile=engnova-upload.jks

# The keystore's own password (protects the file).
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD

# The alias you used with `keytool -alias`. Default from our generator: engnova-upload
keyAlias=engnova-upload

# The key's password. keytool defaults to the same as the store password
# when you press Enter at the "key password" prompt.
keyPassword=REPLACE_WITH_KEY_PASSWORD

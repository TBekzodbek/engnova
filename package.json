{
  "name": "engnova",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Engnova — one Android app hosting CEFR Academy and IELTS Level as two independent products behind a chooser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:android": "node scripts/apply-android-overrides.mjs",
    "cap:android": "npm run build && npx cap sync android && npm run sync:android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.105.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}

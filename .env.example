# Engnova hosts two INDEPENDENT products, each with its own Supabase backend.
# The chooser selects one track; the app only ever talks to that track's backend.
# Copy this file to .env.local and fill in. Anon keys are client-safe (RLS-protected).

# CEFR Academy (cefracademy.uz — project mctcstvjdpcnzypfjhka)
# Reuse the values from D:\cefrprep\.env.local:
#   Supabase Dashboard → Settings → API → Project URL + anon public
VITE_CEFR_SUPABASE_URL=https://mctcstvjdpcnzypfjhka.supabase.co
VITE_CEFR_SUPABASE_ANON_KEY=

# IELTS Level (ieltslevel.uz — project qpukasdtcwwgnehpjhud)
# From Supabase Dashboard → Settings → API. Long JWT starting eyJhbG...
VITE_IELTS_SUPABASE_URL=https://qpukasdtcwwgnehpjhud.supabase.co
VITE_IELTS_SUPABASE_ANON_KEY=

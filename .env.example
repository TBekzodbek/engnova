# Engnova hosts two INDEPENDENT products, each with its own Supabase backend.
# The chooser selects one track; the app only ever talks to that track's backend.
# Copy this file to .env.local and fill in. Anon keys are client-safe (RLS-protected).

# CEFR Academy (cefracademy.uz) — reuse the values from D:\cefrprep\.env.local
VITE_CEFR_SUPABASE_URL=
VITE_CEFR_SUPABASE_ANON_KEY=

# IELTS Level (ieltslevel.uz) — from that project's env (repo not yet on this machine)
VITE_IELTS_SUPABASE_URL=
VITE_IELTS_SUPABASE_ANON_KEY=

# Engnova hosts two INDEPENDENT products, each with its own Supabase backend.
# The chooser selects one track; the app only ever talks to that track's backend.
# Copy this file to .env.local and fill in. Anon keys are client-safe (RLS-protected).

# CEFR Academy (cefracademy.uz — project mctcstvjdpcnzypfjhka)
# Reuse the values from D:\cefrprep\.env.local:
#   Supabase Dashboard → Settings → API → Project URL + anon public
VITE_CEFR_SUPABASE_URL=https://mctcstvjdpcnzypfjhka.supabase.co
VITE_CEFR_SUPABASE_ANON_KEY=

# IELTS Level (ieltslevel.uz — project qpukasdtcwwgnehpjhud)
# From Supabase Dashboard → Settings → API. Long JWT starting eyJhbG...
VITE_IELTS_SUPABASE_URL=https://qpukasdtcwwgnehpjhud.supabase.co
VITE_IELTS_SUPABASE_ANON_KEY=

# Google Sign-In — the OAuth 2.0 WEB application client ID from Google Cloud
# Console (NOT the Android one; format is <digits>-<hash>.apps.googleusercontent.com).
# See store-assets/google-signin-setup.md for the setup walkthrough.
# The same Web Client ID works for BOTH CEFR + IELTS as long as both
# Supabase projects have their Google provider configured with it.
VITE_GOOGLE_WEB_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Engnova — standalone product (added 2026-08-13 pivot)
# ─────────────────────────────────────────────────────────────────────────────
# Engnova now has its OWN Supabase project, separate from CEFR + IELTS above.
# Cefracademy / ieltslevel accounts CANNOT sign in to Engnova. Create a new
# Supabase project ("engnova"), enable the Google provider on it (can reuse
# the same Web Client ID above), and paste URL + anon key here.
#
# CRITICAL: also configure SMTP in the new project (Auth → Providers → Email).
# The cefracademy Supabase's email pipeline is currently broken (500 on all
# /auth/v1/recover calls) — don't inherit that failure mode.
VITE_ENGNOVA_SUPABASE_URL=
VITE_ENGNOVA_SUPABASE_ANON_KEY=

# Telegram Login — bot username (WITHOUT the @). The bot must exist in
# @BotFather, and its domain must be set with /setdomain to the domain
# that will host the Telegram Login Widget callback (engnova.uz once live,
# or a temporary Vercel URL until then).
# The full end-to-end flow also requires:
#   - A Supabase Edge Function `telegram-auth-callback` that receives the
#     bot's Contact payload and creates a session (see lib/telegramAuth.ts
#     comment header for the full sequence).
#   - A `poll_telegram_session` RPC + `telegram_sessions` table.
# Until this env var is set, the Telegram button is hidden on the login
# screen — the same "no broken affordances" discipline as the Google button.
VITE_ENGNOVA_TG_BOT_USERNAME=
